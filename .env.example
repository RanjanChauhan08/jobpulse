# Local development only. Do not commit a real .env file.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-local-development-key

# Comma-separated values. Set these in Render's environment settings using the
# exact generated service URL and any custom domains you attach.
ALLOWED_HOSTS=jobpulse.vercel.app
CSRF_TRUSTED_ORIGINS=https://jobpulse.vercel.app
